<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 0.108.0: only this app (same signing key) may deliver install results to its receiver (Android 8-12 have no RECEIVER_NOT_EXPORTED) -->
    <permission android:name="dev.apkrelab.permission.INSTALL_RESULT" android:protectionLevel="signature" />
    <uses-permission android:name="dev.apkrelab.permission.INSTALL_RESULT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- the "Installed apps" picker lists every installed app to analyse it (a sideloaded security tool, not a Play Store app) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="APK ReLab"
        android:theme="@style/ReLabLaunch">
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".BuildService" android:exported="false" android:foregroundServiceType="dataSync" />
    </application>
</manifest>
