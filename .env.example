# Copy to .env and fill in. Never commit .env.
# Provider: anthropic | openai | gemini | ollama | offline
LLM_PROVIDER=anthropic
API_KEY=
# Legacy single-model override (applies to tier 1)
LLM_MODEL=
# Local Ollama fallback (used if the primary provider fails / has no key)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_FALLBACK_OLLAMA=true

# Financial model: strict seed capital (hard ceiling for ALL API spend; revenue can never raise it)
SEED_CAPITAL_USD=10
COMPUTE_RATE_USD_PER_HOUR=0
# 2-tier router overrides (defaults: haiku-5-5 workhorse / opus-5-5 CEO gate for Anthropic)
LLM_MODEL_T1=
LLM_MODEL_T2=
# Optional: PRJ-03 batch audits (CSV columns: url,ceo,company)
# TARGETS_FILE=prospects.csv
# TARGETS_MAX=500
# CEO quality gate (percent)
QC_THRESHOLD=95
MAX_REVISION_CYCLES=3
