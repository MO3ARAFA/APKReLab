# Copy to .env and fill in. Never commit .env.
# Provider: anthropic | openai | gemini | ollama | offline
LLM_PROVIDER=anthropic
API_KEY=
# Optional model override (defaults per provider are in llm.py)
LLM_MODEL=
# Local Ollama fallback (used if the primary provider fails / has no key)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_FALLBACK_OLLAMA=true

# Financial model
AGENCY_BUDGET_USD=50
COMPUTE_RATE_USD_PER_HOUR=0.10
# CEO quality gate (percent)
QC_THRESHOLD=95
MAX_REVISION_CYCLES=3
