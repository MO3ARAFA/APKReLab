# Copy to .env and fill in. Never commit .env.
# Provider: anthropic | openai | gemini | ollama | offline
LLM_PROVIDER=anthropic
API_KEY=
# Legacy single-model override (applies to tier 1)
LLM_MODEL=
# Local Ollama fallback (used if the primary provider fails / has no key)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_FALLBACK_OLLAMA=true

# Name used to sign outreach messages
SENDER_NAME=Mohamed

# Financial model: strict seed capital (hard ceiling for ALL API spend; revenue can never raise it)
SEED_CAPITAL_USD=10
COMPUTE_RATE_USD_PER_HOUR=0
# 2-tier router overrides (defaults: haiku-5-5 workhorse / opus-5-5 CEO gate for Anthropic)
LLM_MODEL_T1=
LLM_MODEL_T2=
# Optional: PRJ-03 batch audits (CSV columns: url,ceo,company)
# TARGETS_FILE=prospects.csv
# TARGETS_MAX=500
# CEO quality gate (percent)
QC_THRESHOLD=95
MAX_REVISION_CYCLES=3

# PM-06 free lane: keys you registered BY HAND (see docs/FREE_TIERS.md). Leave blank to disable a provider.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_FREE_API_KEY=
MISTRAL_API_KEY=
# FREE_PROVIDERS=ollama,groq,openrouter,gemini_free,mistral   # restrict / reorder the lane
# FREE_MODEL_GROQ=llama-3.1-8b-instant
# FREE_LIMITS_JSON={"groq": {"rpm": 10, "rpd": 200}}
FREE_LANE_ENABLED=true
FREE_LANE_THRESHOLD_USD=0.50
CONSERVE_BELOW_PCT=25
PAID_RETRY_HOURS=6

# Phase 7 - AI COO daemon (python main.py --daemon) and Telegram. See docs/AUTOPILOT.md.
# 1) create a bot with @BotFather, put its token here; 2) run: python main.py --telegram-setup; 3) put the printed chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAEMON_CYCLE_HOURS=12
DAEMON_QUIET_HOURS=23-8
DAEMON_DAILY_CAP_USD=0.15
DAEMON_LIVE_CAP_USD=0.10
DAEMON_MAX_FAILURES=3
DAEMON_PROPOSAL_TTL_HOURS=24
DAEMON_REJECT_COOLDOWN_HOURS=24
